exports[`buildProjectFiles (swarm_license) generates stable schema and handlers 2`] = `
"/**
 * Handlers for \`lease\` events.
 *
 * GENERATED as a starting point; edit freely (regenerating overwrites it).
 * Each handler receives a run of consecutive same-type events, in ledger order,
 * inside the transaction that also advances the stream cursor: throw to roll
 * back the whole page, it is retried on the next tick.
 */
import { leaseLeaseBookCreatedEvent, leaseLeaseBookUpgradedEvent, leaseLeasedEvent, leaseLeasingPausedEvent, leaseReleasedEvent } from '../db/schema';
import { asBool, asJson, asNumeric, asOption, asText } from '../lib/decode';
import type { LeaseBookCreatedEvent, LeaseBookUpgradedEvent, LeasedEvent, LeasingPausedEvent, ReleasedEvent } from '../types/moveTypes';
import { eventMeta, type Handler, type IndexedEvent } from './types';

export const leaseHandlers = {
  /** \`lease::LeaseBookCreatedEvent\` -> \`lease_lease_book_created_event\` */
  LeaseBookCreatedEvent: async (tx, events: IndexedEvent<LeaseBookCreatedEvent>[]) => {
    await tx
      .insert(leaseLeaseBookCreatedEvent)
      .values(
        events.map((e) => ({
          ...eventMeta(e),
          leaseBookId: asText(e.json.lease_book_id, 'lease_book_id'),
        })),
      )
      // Replays (restarts, cursor resets) are no-ops: (tx digest, event seq) is the key.
      .onConflictDoNothing();
  },

  /** \`lease::LeaseBookUpgradedEvent\` -> \`lease_lease_book_upgraded_event\` */
  LeaseBookUpgradedEvent: async (tx, events: IndexedEvent<LeaseBookUpgradedEvent>[]) => {
    await tx
      .insert(leaseLeaseBookUpgradedEvent)
      .values(
        events.map((e) => ({
          ...eventMeta(e),
          leaseBookId: asText(e.json.lease_book_id, 'lease_book_id'),
          from: asNumeric(e.json.from, 'from'),
          to: asNumeric(e.json.to, 'to'),
        })),
      )
      // Replays (restarts, cursor resets) are no-ops: (tx digest, event seq) is the key.
      .onConflictDoNothing();
  },

  /** \`lease::LeasedEvent\` -> \`lease_leased_event\` */
  LeasedEvent: async (tx, events: IndexedEvent<LeasedEvent>[]) => {
    await tx
      .insert(leaseLeasedEvent)
      .values(
        events.map((e) => ({
          ...eventMeta(e),
          leaseId: asText(e.json.lease_id, 'lease_id'),
          lessee: asText(e.json.lessee, 'lessee'),
          licenseIds: asJson<string[]>(e.json.license_ids, 'license_ids'),
          origins: asJson<string[]>(e.json.origins, 'origins'),
          termMonths: asNumeric(e.json.term_months, 'term_months'),
          startMs: asNumeric(e.json.start_ms, 'start_ms'),
          endMs: asNumeric(e.json.end_ms, 'end_ms'),
          legacyLeaseId: asOption(e.json.legacy_lease_id, 'legacy_lease_id', asNumeric),
        })),
      )
      // Replays (restarts, cursor resets) are no-ops: (tx digest, event seq) is the key.
      .onConflictDoNothing();
  },

  /** \`lease::LeasingPausedEvent\` -> \`lease_leasing_paused_event\` */
  LeasingPausedEvent: async (tx, events: IndexedEvent<LeasingPausedEvent>[]) => {
    await tx
      .insert(leaseLeasingPausedEvent)
      .values(
        events.map((e) => ({
          ...eventMeta(e),
          leaseBookId: asText(e.json.lease_book_id, 'lease_book_id'),
          isPaused: asBool(e.json.is_paused, 'is_paused'),
        })),
      )
      // Replays (restarts, cursor resets) are no-ops: (tx digest, event seq) is the key.
      .onConflictDoNothing();
  },

  /** \`lease::ReleasedEvent\` -> \`lease_released_event\` */
  ReleasedEvent: async (tx, events: IndexedEvent<ReleasedEvent>[]) => {
    await tx
      .insert(leaseReleasedEvent)
      .values(
        events.map((e) => ({
          ...eventMeta(e),
          leaseId: asText(e.json.lease_id, 'lease_id'),
          licenseId: asText(e.json.license_id, 'license_id'),
          origin: asText(e.json.origin, 'origin'),
          lessee: asText(e.json.lessee, 'lessee'),
          endMs: asNumeric(e.json.end_ms, 'end_ms'),
          releasedMs: asNumeric(e.json.released_ms, 'released_ms'),
          remaining: asNumeric(e.json.remaining, 'remaining'),
        })),
      )
      // Replays (restarts, cursor resets) are no-ops: (tx digest, event seq) is the key.
      .onConflictDoNothing();
  },
} satisfies Record<string, Handler>;
"
`;

