{
  "name": "sui-events-indexer",
  "version": "2.0.0",
  "description": "A CLI that generates a Bun + Drizzle event indexer for Sui Move packages",
  "type": "module",
  "bin": {
    "sui-events-indexer": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "sui",
    "move",
    "blockchain",
    "events",
    "indexer",
    "typescript",
    "bun",
    "drizzle"
  ],
  "author": "Buidly",
  "license": "MIT",
  "scripts": {
    "dev": "bun src/index.ts",
    "generate": "bun src/index.ts generate",
    "inspect": "bun src/index.ts inspect",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@mysten/sui": "^2.37.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
